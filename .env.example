# GEMINI_API_KEY: Optional for server-side Gemini features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH:
# - Use "/" when running locally, on a custom domain, or on <username>.github.io
# - Use "/<repo-name>/" when deploying to GitHub Pages project sites (https://<username>.github.io/<repo-name>/)
VITE_BASE_PATH="/"

# VITE_API_BASE_URL (OPTIONAL):
# - Leave "" / unset for 100% billing-free GitHub Pages hosting (browser WebM & WebCodecs MP4
#   export, Mode A cards, templates, music, and Firebase Auth/Firestore work without a backend).
# - Only needed if you self-host server.ts or deploy Cloud Functions for server-side Mode B verification.
VITE_API_BASE_URL=""

# Optional server.ts runtime variables (Node backend only; do not prefix with VITE_):
# CORS_ORIGIN="https://<username>.github.io"
# DATA_DIR="/mnt/data"
