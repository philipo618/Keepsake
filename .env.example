# GEMINI_API_KEY: Optional for server-side Gemini features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Set to /<repo-name>/ when deploying to GitHub Pages project sites.
VITE_BASE_PATH="/"

# VITE_API_BASE_URL: Optional Cloud Functions or backend API base URL for static GitHub Pages builds.
VITE_API_BASE_URL=""
