# GEMINI_API_KEY: Optional for server-side Gemini features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH:
# - Use "/" when running locally, on a custom domain, or on <username>.github.io
# - Use "/<repo-name>/" when deploying to GitHub Pages project sites (https://<username>.github.io/<repo-name>/)
VITE_BASE_PATH="/"

# VITE_API_BASE_URL:
# - Leave "" when serving frontend + Express server.ts from the same origin (AI Studio / Cloud Run / Node)
# - Set to your deployed Cloud Run service origin (e.g. https://keepsake-api-xxxxx-uc.a.run.app)
#   or Firebase Cloud Functions v2 URL (e.g. https://<region>-pd-ai-2.cloudfunctions.net/api)
#   when hosting static files on GitHub Pages. Note: src/lib/api.ts avoids duplicating `/api`.
VITE_API_BASE_URL=""

# Optional server.ts runtime variables (Cloud Run / Node backend only; do not prefix with VITE_):
# CORS_ORIGIN="https://<username>.github.io"
# DATA_DIR="/mnt/data"
